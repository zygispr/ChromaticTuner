{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    // `node` alongside `jest` because the tests run in Node and some of them
    // read the source tree — `settings-modality.test.tsx` asserts FR-142 by
    // scanning for scrollers, because this environment renders a real
    // ScrollView as an indistinguishable `View`. eslint.config.js already
    // grants `globals.node` to `__tests__/**` for the same reason; this is the
    // type checker agreeing with a decision the linter had already made.
    "types": ["jest", "node"]
  },
  // metro.config.js and babel.config.js are excluded: their inferred types
  // reference pnpm's nested store paths and cannot be named portably (TS2742).
  // They remain covered by ESLint.
  "include": ["src/**/*", "__tests__/**/*", "index.js"]
}
